{
    "mcpServers": {
        "context7": {
            "alwaysAllow": [
                "resolve-library-id",
                "get-library-docs"
            ],
            "args": [
                "-y",
                "@upstash/context7-mcp"
            ],
            "command": "npx",
            "env": {
                "DEFAULT_MINIMUM_TOKENS": ""
            }
        },
        "memory": {
            "args": [
                "-y",
                "@modelcontextprotocol/server-memory"
            ],
            "command": "npx"
        },
        "serena": {
            "args": [
                "--from",
                "serena-agent",
                "serena-mcp-server"
            ],
            "command": "uvx"
        }
    }
}