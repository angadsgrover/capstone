# ═══════════════════════════════════════════════════════════════════════════════
# Aviation AI Agent - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# For Docker: also copy to project root as .env

# ── LLM Provider (Required) ────────────────────────────────────────────────────
LLM_API_KEY=sk-or-v1-your-openrouter-api-key
MODEL_CHOICE=qwen/qwen3-vl-8b-instruct
BASE_URL=https://openrouter.ai/api/v1

# Recommended models:
#   qwen/qwen3-vl-8b-instruct     - Fast, good for real-time
#   anthropic/claude-3.5-sonnet   - Best quality
#   openai/gpt-4o-mini            - Balanced
#   google/gemini-2.0-flash       - Fast multimodal

# ── Embeddings (Optional - defaults to LLM provider) ───────────────────────────
# Override if using a different provider for embeddings
# EMBED_API_KEY=sk-your-embedding-api-key
# EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=openai/text-embedding-3-small

# Supported embedding models:
#   openai/text-embedding-3-small (1536 dims) - Recommended, balanced cost/quality
#   openai/text-embedding-3-large (3072 dims) - Highest quality
#   cohere/embed-english-v3.0    (1024 dims) - Good for multilingual
#   mistralai/mistral-embed      (1024 dims) - Fast, cost-effective
#   nomic/nomic-embed-text-v1.5  (768 dims)  - Smallest, fastest

# ── Transcription (Optional - for voice input in Brave/Firefox/Safari) ─────────
# Uses OpenRouter audio-capable model for transcription when Web Speech API unavailable
# Falls back to LLM_API_KEY if not set
# TRANSCRIBE_API_KEY=sk-or-v1-your-transcription-api-key
# TRANSCRIBE_MODEL=google/gemini-2.5-flash

# RAG Hybrid Search settings
RAG_HYBRID_VECTOR_WEIGHT=0.7
RAG_HYBRID_BM25_WEIGHT=0.3
RAG_HYBRID_OVERFETCH_FACTOR=4
RAG_HYBRID_OVERFETCH_CAP=60

# ── PostgreSQL (Required for memory/RAG) ───────────────────────────────────────
POSTGRES_PASSWORD=your-secure-password-here
# For local dev (override in shell):
# POSTGRES_DSN=postgresql://capstone:${POSTGRES_PASSWORD}@localhost:5432/capstone
# For Docker (auto-constructed in docker-compose.yml)

# ── Redis Cache (Optional) ─────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
# REDIS_URL=redis://localhost:6379/0  # Local dev
# For Docker (auto-constructed)

# ── LangSmith Observability (Optional but Recommended) ─────────────────────────
# Sign up at https://smith.langchain.com and create a project to get your API key
# Enables: LLM call tracing, latency monitoring, cost tracking, prompt analytics
#
# Features:
#   - Automatic tracing of all LangGraph/LangChain operations (native integration)
#   - Session-based grouping of related traces
#   - User feedback scoring via /api/feedback endpoint
#   - Debug view in LangSmith dashboard
#   - Evaluation and dataset management
#
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls-your-api-key
# LANGSMITH_PROJECT=default                      # Project name (default: "default")
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # Default: US cloud
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com  # EU cloud region

# ── Neo4j Graph Database (Optional - for graph search enhancements) ───────────
# Enable with: docker compose --profile graph up
NEO4J_PASSWORD=your-neo4j-password
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j

# ── Mem0 Cloud Memory (Long-term + Short-term) ─────────────────────────────────
MEM0_API_KEY=m0-your-mem0-cloud-api-key
MEM0_LONG_TERM_ENABLED=true
MEM0_LONG_TERM_USER_ID=aviation_knowledge_base
MEM0_SHORT_TERM_APP_ID=chat_sessions
# Optional: promote finalized chat turns into session long-term memory
CHAT_LONG_TERM_MEMORY_ENABLED=false
CHAT_LONG_TERM_MEMORY_MIN_CHARS=120

# ── Agent Behavior ─────────────────────────────────────────────────────────────
MAX_HISTORY_MESSAGES=20
MAX_RESPONSE_TOKENS=2048
MAX_TOOL_OUTPUT_CHARS=8000
LOG_LEVEL=INFO

# ── Session Continuity & Horizontal Scale (Recommended for Production) ────────
# Event backend for cross-replica SSE/run visibility
EVENT_BACKEND=redis
REDIS_EVENT_STREAM_MAXLEN=2000
REDIS_EVENT_BLOCK_MS=60000

# Queue-based execution (API replicas enqueue, worker replicas execute)
EXECUTION_MODE=queued
WORKFLOW_QUEUE_KEY=agent:workflow:queue
WORKFLOW_QUEUE_PROCESSING_KEY=agent:workflow:processing
WORKFLOW_QUEUE_REQUEUE_ON_START=true
ENABLE_WORKFLOW_WORKER=false
WORKFLOW_WORKER_POLL_SECONDS=1

# Session guard: prevents overlapping runs in the same session/thread
SESSION_RUN_GUARD_ENABLED=true
SESSION_RUN_GUARD_TTL_SECONDS=14400
SESSION_RUN_GUARD_KEY_PREFIX=agent:session_guard:

# Run registry retention and bounded in-memory queues
RUN_REGISTRY_TTL_SECONDS=900
RUN_REGISTRY_CLEANUP_INTERVAL_SECONDS=60
EVENT_QUEUE_MAXSIZE=512

# Deployment runtime mode
DEPLOYMENT_RUNTIME_MODE=local
# DEPLOYMENT_STATE_FILE=agent/data/deployment_state.json
# Optional: proxy deployment APIs to an external Agent Server
# LANGSMITH_AGENT_SERVER_URL=https://your-agent-server
# LANGSMITH_AGENT_SERVER_API_KEY=ls-...

# ── Cloud Deployment ───────────────────────────────────────────────────────────
# Set these for production/cloud deployments

# Domain for HTTPS (used by Caddy)
# DOMAIN=aviation.example.com

# CORS (set to your frontend domain in production)
# CORS_ALLOW_ORIGINS=https://aviation.example.com

# Environment marker
# ENVIRONMENT=production

# LiveKit (for real-time voice features)
# Sign up at https://cloud.livekit.io or self-host
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret
# LIVEKIT_URL=wss://your-project.livekit.cloud

# ═══════════════════════════════════════════════════════════════════════════════
# Quick Start Commands
# ═══════════════════════════════════════════════════════════════════════════════
#
# LOCAL DEVELOPMENT:
#   make setup          # First time: install deps
#   make dev            # Start all services locally
#
# DOCKER (Development):
#   make docker         # Build and start all containers
#   make health         # Check service status
#   make logs           # Tail logs
#
# DOCKER (Production):
#   make docker-prod    # Start with resource limits and health checks
#
# DATABASE:
#   make db-shell       # PostgreSQL shell
#   make db-embeddings  # Show embedding counts
#
# TESTING:
#   make test           # Run integration tests
#   curl http://localhost:8000/api/agent -X POST \
#     -H "Content-Type: application/json" \
#     -d '{"input":"METAR for VHHH","session_id":"test"}'
#
# ═══════════════════════════════════════════════════════════════════════════════
