# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── LLM provider ──────────────────────────────────────────────────────────────
LLM_API_KEY=sk-your-openrouter-key-here
BASE_URL=https://openrouter.ai/api/v1
MODEL_CHOICE=qwen/qwen3-8b

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_strong_password
# DSN is assembled by docker-compose; override here for local dev
# POSTGRES_DSN=postgresql://capstone:changeme@localhost:5432/capstone

# ── Neo4j (only needed with --profile graph) ──────────────────────────────────
NEO4J_PASSWORD=changeme_neo4j

# ── Observability (optional) ──────────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...

# ── Embeddings (optional; defaults to LLM provider) ──────────────────────────────
# By default, embeddings use the same provider as chat LLM (BASE_URL / LLM_API_KEY).
# Override to use a different provider or model for embeddings.
# EMBED_API_KEY=sk-...          # leave blank to use LLM_API_KEY
# EMBED_BASE_URL=https://api.openai.com/v1  # leave blank to use BASE_URL
# EMBED_MODEL=openai/text-embedding-3-small # default; alternatives:
#   - openai/text-embedding-3-large (3072 dims, premium quality)
#   - cohere/embed-english-v3.0 (1024 dims)
#   - mistralai/mistral-embed (1024 dims)
#   - nomic/nomic-embed-text-v1.5 (768 dims, lightweight)
#   - nvidia/llama-nemotron-embed-vl-1b-v2 (multimodal, images + text)
#   See: https://openrouter.ai/models?fmt=cards&output_modalities=embeddings

# ── Memory System (Dual: mem0 + cognee) ──────────────────────────────────────
# Short-term memory (mem0): Recent conversational context, user preferences
# Long-term memory (cognee): Knowledge graphs, domain expertise, safety documents
#
# mem0 (short-term) is automatically enabled if POSTGRES_DSN is set.
# cognee (long-term) requires POSTGRES_DSN + optional Neo4j for enhanced graph queries.
COGNEE_ENABLED=true
# NEO4J_URI=bolt://localhost:7687  # Optional: enhances cognee with graph DB
# NEO4J_USER=neo4j                 # Default: neo4j
# Required if using Neo4j (already defined above):
# NEO4J_PASSWORD=changeme_neo4j

# ── Cache System (Redis) ──────────────────────────────────────────────────────
# High-performance query cache for weather, RAG, knowledge graph, LLM responses
REDIS_URL=redis://localhost:6379/0  # Redis connection string
CACHE_ENABLED=true                   # Enable/disable caching (default: true)
# Optional: Custom TTL values (seconds)
# CACHE_TTL_WEATHER=900              # Weather cache TTL (default: 15 min)
# CACHE_TTL_RAG=3600                 # RAG cache TTL (default: 1 hour)
# CACHE_TTL_KNOWLEDGE=86400          # Knowledge graph TTL (default: 24 hours)
# CACHE_TTL_LLM=300                  # LLM response TTL (default: 5 min)
