# ═══════════════════════════════════════════════════════════════════════════════
# Aviation AI Agent - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# For Docker: also copy to project root as .env

# ── LLM Provider (Required) ────────────────────────────────────────────────────
LLM_API_KEY=sk-or-v1-your-openrouter-api-key
MODEL_CHOICE=qwen/qwen3-vl-8b-instruct
BASE_URL=https://openrouter.ai/api/v1

# Recommended models:
#   qwen/qwen3-vl-8b-instruct     - Fast, good for real-time
#   anthropic/claude-3.5-sonnet   - Best quality
#   openai/gpt-4o-mini            - Balanced
#   google/gemini-2.0-flash       - Fast multimodal

# ── Embeddings (Optional - defaults to LLM provider) ───────────────────────────
# Override if using a different provider for embeddings
# EMBED_API_KEY=sk-your-embedding-api-key
# EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=openai/text-embedding-3-small

# Supported embedding models:
#   openai/text-embedding-3-small (1536 dims) - Recommended, balanced cost/quality
#   openai/text-embedding-3-large (3072 dims) - Highest quality
#   cohere/embed-english-v3.0    (1024 dims) - Good for multilingual
#   mistralai/mistral-embed      (1024 dims) - Fast, cost-effective
#   nomic/nomic-embed-text-v1.5  (768 dims)  - Smallest, fastest

# RAG Hybrid Search settings
RAG_HYBRID_VECTOR_WEIGHT=0.7
RAG_HYBRID_BM25_WEIGHT=0.3
RAG_HYBRID_OVERFETCH_FACTOR=4
RAG_HYBRID_OVERFETCH_CAP=60

# ── PostgreSQL (Required for memory/RAG) ───────────────────────────────────────
POSTGRES_PASSWORD=your-secure-password-here
# For local dev (override in shell):
# POSTGRES_DSN=postgresql://capstone:${POSTGRES_PASSWORD}@localhost:5432/capstone
# For Docker (auto-constructed in docker-compose.yml)

# ── Redis Cache (Optional) ─────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
# REDIS_URL=redis://localhost:6379/0  # Local dev
# For Docker (auto-constructed)

# ── Langfuse Observability (Optional but Recommended) ──────────────────────────
# Sign up at https://langfuse.com and create a project to get these keys
# Enables: LLM call tracing, latency monitoring, cost tracking, prompt analytics
#
# Features:
#   - Automatic tracing of all LangGraph/LangChain operations
#   - Session-based grouping of related traces
#   - User feedback scoring via /api/feedback endpoint
#   - Debug view in Langfuse Cloud dashboard
#
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# LANGFUSE_HOST=https://cloud.langfuse.com      # Default: EU cloud
# LANGFUSE_HOST=https://us.cloud.langfuse.com   # US cloud region
# LANGFUSE_HOST=https://your-self-hosted.com    # Self-hosted instance

# ── Neo4j Graph Database (Optional - for cognee long-term memory) ──────────────
# Enable with: docker compose --profile graph up
NEO4J_PASSWORD=your-neo4j-password
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j

# ── Cognee Long-term Memory (Optional) ─────────────────────────────────────────
COGNEE_ENABLED=true

# ── Agent Behavior ─────────────────────────────────────────────────────────────
MAX_HISTORY_MESSAGES=20
MAX_RESPONSE_TOKENS=2048
MAX_TOOL_OUTPUT_CHARS=8000
LOG_LEVEL=INFO

# ── Cloud Deployment ───────────────────────────────────────────────────────────
# Set these for production/cloud deployments
# ENVIRONMENT=production
# CORS_ORIGINS=https://your-domain.com
# API_KEY_REQUIRED=true
# API_KEY=your-api-key-for-production

# ═══════════════════════════════════════════════════════════════════════════════
# Quick Start Commands
# ═══════════════════════════════════════════════════════════════════════════════
#
# LOCAL DEVELOPMENT:
#   make setup          # First time: install deps
#   make dev            # Start all services locally
#
# DOCKER (Development):
#   make docker         # Build and start all containers
#   make health         # Check service status
#   make logs           # Tail logs
#
# DOCKER (Production):
#   make docker-prod    # Start with resource limits and health checks
#
# DATABASE:
#   make db-shell       # PostgreSQL shell
#   make db-embeddings  # Show embedding counts
#
# TESTING:
#   make test           # Run integration tests
#   curl http://localhost:8000/api/agent -X POST \
#     -H "Content-Type: application/json" \
#     -d '{"input":"METAR for VHHH","session_id":"test"}'
#
# ═══════════════════════════════════════════════════════════════════════════════
